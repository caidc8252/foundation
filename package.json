{
  "name": "@cloud/foundation",
  "version": "0.7.1",
  "private": true,
  "description": "Shared design foundation — single source of truth for tokens, primitive contracts, pattern archetypes, and design governance. Consumed by the Next.js app (@cloud/ui) and by artifact-design prototypes.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./tokens": "./tokens/index.css",
    "./tokens/*": "./tokens/*.css",
    "./tokens.inline.css": "./release/tokens.inline.css",
    "./tokens.json": "./release/tokens.json",
    "./primitives.css": "./primitives/primitives.css",
    "./composites.css": "./composites/composites.css",
    "./patterns.router.json": "./patterns/router.json",
    "./catalog.json": "./release/catalog.json",
    "./catalog.md": "./release/catalog.md"
  },
  "files": [
    "tokens",
    "release",
    "versions",
    "primitives",
    "composites",
    "patterns",
    "governance",
    "scripts",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md"
  ],
  "scripts": {
    "build": "node emit/build.mjs",
    "artifact": "node scripts/build-artifact.mjs",
    "icon": "node scripts/icon/icon.mjs",
    "icons:refresh": "node scripts/icon/refresh.mjs",
    "check": "node scripts/check-artifact.mjs",
    "check:build": "node --test emit/build.test.mjs",
    "check:promote": "node --test scripts/promote-version.test.mjs",
    "check:patterns": "node scripts/check-pattern-router.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:all": "node --test emit/build.test.mjs scripts/check-artifact.test.mjs scripts/promote-version.test.mjs scripts/release-lib.test.mjs && node scripts/check-release.mjs && node scripts/check-examples.mjs --strict && node scripts/check-pattern-router.mjs",
    "visual:render": "node scripts/visual/render.mjs",
    "visual:sticky": "node scripts/visual/sticky-check.mjs composites/summary-bar.html patterns/list-page.html patterns/list-page-advanced-filter.html",
    "visual:setup": "playwright install chromium",
    "docs": "node emit/docs.mjs",
    "docs:serve": "node emit/docs.mjs && python3 emit/serve.py 4000",
    "promote": "node scripts/promote-version.mjs",
    "finalize": "node scripts/finalize-promoted-version.mjs",
    "apply-draft": "node scripts/apply-draft.mjs",
    "release": "node scripts/release.mjs",
    "restore:source": "node scripts/restore-version-source.mjs"
  },
  "devDependencies": {
    "playwright": "^1.45.0",
    "sharp": "^0.33.0"
  }
}
