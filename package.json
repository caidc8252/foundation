{
  "name": "@cloud/foundation",
  "version": "0.1.0",
  "private": true,
  "description": "Shared design foundation — single source of truth for tokens, primitive contracts, pattern archetypes, and design governance. Consumed by the Next.js app (@cloud/ui) and by artifact-design prototypes.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./tokens": "./tokens/index.css",
    "./tokens/*": "./tokens/*.css",
    "./tokens.inline.css": "./dist/tokens.inline.css",
    "./tokens.json": "./dist/tokens.json",
    "./primitives.css": "./primitives/primitives.css",
    "./composites.css": "./composites/composites.css",
    "./catalog.json": "./dist/catalog.json",
    "./catalog.md": "./dist/catalog.md"
  },
  "files": [
    "tokens",
    "dist",
    "primitives",
    "composites",
    "patterns",
    "governance",
    "scripts",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md"
  ],
  "scripts": {
    "build": "node emit/build.mjs",
    "check": "node scripts/check-artifact.mjs"
  }
}
