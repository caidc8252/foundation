{
  "version": 1,
  "purpose": "Machine-readable generation schema for artifact-side composites. Contracts remain authoritative; this file helps AI choose and configure composites without inventing classes or structure.",
  "composites": {
    "app-frame": {
      "intent": "Production-like shell used only as pattern context, not ported into frameless artifacts.",
      "contract": "composites/app-frame.md",
      "usedByPatterns": ["actions", "create-form", "create-wizard", "detail-page", "list-page"],
      "classes": ["app-frame", "app-frame__sidebar", "app-frame__col", "app-frame__header", "app-frame__main"],
      "requiredSlots": ["sidebar", "header", "main"],
      "optionalSlots": ["collapsedSidebar", "activeNavItem", "avatar"],
      "variants": ["collapsed"],
      "states": ["activeNavItem"],
      "artifactRecipe": {
        "root": "div.app-frame",
        "structure": ["aside.app-frame__sidebar", "div.app-frame__col > header.app-frame__header + main.app-frame__main"],
        "notes": ["Do not port app-frame into default shipped artifacts; use it only for in-repo pattern examples or full production chrome previews."]
      }
    },
    "chart": {
      "intent": "Token-skinned chart chrome for bars, lines, sparklines, legends, tooltips, empty and loading states.",
      "contract": "composites/chart.md",
      "usedByPatterns": [],
      "classes": ["chart", "chart__grid", "chart__axis", "chart__tick", "chart__bar", "chart__curve", "chart__series--selected", "chart-legend", "chart-legend__item", "chart-legend__swatch", "chart-tooltip", "chart-tooltip__header", "chart-tooltip__row", "chart-tooltip__indicator", "chart-tooltip__name", "chart-tooltip__value", "chart-tooltip__total", "chart-sparkline", "chart-empty", "chart-empty__icon", "chart-empty__title", "chart-empty__description", "chart-skeleton"],
      "requiredSlots": ["data"],
      "optionalSlots": ["legend", "tooltip", "emptyState", "loadingState", "selectedSeries", "filteredSeries"],
      "variants": ["bar", "line", "sparkline", "empty", "loading"],
      "states": ["selected", "dimmed", "filtered", "off"],
      "artifactRecipe": {
        "root": "div.chart",
        "structure": ["chart drawing primitives", "optional .chart-legend", "optional .chart-tooltip"],
        "notes": ["Use chart color tokens only; do not hardcode series colors.", "Keep chart logic outside the design vocabulary."]
      }
    },
    "data-table": {
      "intent": "Config-driven table for scanning, sorting, selecting, and acting on rows.",
      "contract": "composites/data-table.md",
      "usedByPatterns": ["list-page", "detail-page"],
      "classes": ["table-frame", "table-scroll", "data-table", "cell-num", "cell-right", "row-actions", "col-select"],
      "requiredSlots": ["columns", "rows"],
      "optionalSlots": ["selection", "sort", "rowActions", "numericColumns", "emptyState", "loadingState"],
      "variants": ["compact", "comfortable", "spacious", "stickyHead", "stickyCol", "striped"],
      "states": ["selectedRow", "sortableColumn", "sortedColumn", "loading", "empty"],
      "slotSchema": {
        "columns": {
          "type": "array",
          "itemShape": {
            "key": "stable column id",
            "label": "visible header text",
            "kind": "text | twoLine | numeric | date | badge | actions",
            "align": "left | right",
            "sortable": "boolean"
          }
        },
        "rows": {
          "type": "array",
          "itemShape": "object keyed by column key"
        }
      },
      "artifactRecipe": {
        "root": "div.table-frame > div.table-scroll > table.data-table",
        "structure": ["thead > tr > th", "tbody > tr > td"],
        "notes": ["Use .cell-num for numeric, id, currency, and date cells.", "Use .cell-right for right-aligned cells.", "Selection uses .col-select.", "Wide tables scroll in .table-scroll; the page never scrolls horizontally."]
      }
    },
    "detail-header": {
      "intent": "Detail screen identity band with optional back button, logo, status, metadata, actions, and tabs.",
      "contract": "composites/detail-header.md",
      "usedByPatterns": ["detail-page"],
      "classes": ["detail-header", "detail-header__bar", "detail-header__logo", "detail-header__main", "detail-header__title", "detail-header__meta", "detail-header__chips", "detail-header__actions", "detail-header__tabs", "tabs__list--line", "badge"],
      "requiredSlots": ["title"],
      "optionalSlots": ["backAction", "logo", "statusBadges", "meta", "actions", "tabs"],
      "variants": ["sticky", "tabbed", "overviewOnly"],
      "states": ["activeTab"],
      "artifactRecipe": {
        "root": "header.detail-header",
        "structure": ["div.detail-header__bar", "optional div.detail-header__tabs"],
        "notes": ["Record-level mutation actions live here, not on list rows.", "At most one primary action.", "Tabs, when present, dock to the bottom of the header band."]
      }
    },
    "diff": {
      "intent": "Compact before-to-after value comparison.",
      "contract": "composites/diff.md",
      "usedByPatterns": ["actions", "detail-page"],
      "classes": ["diff", "diff__col--old", "diff__arrow", "diff__col--new", "diff__label", "diff__value", "diff--inline"],
      "requiredSlots": ["oldValue", "newValue"],
      "optionalSlots": ["label", "arrow", "inline"],
      "variants": ["block", "inline"],
      "states": [],
      "artifactRecipe": {
        "root": "div.diff",
        "structure": ["old column", "arrow", "new column"],
        "notes": ["Use for audit previews or confirm-before-save comparisons."]
      }
    },
    "empty-state": {
      "intent": "First-class empty, no-results, or cold-start state.",
      "contract": "composites/empty-state.md",
      "usedByPatterns": ["list-page", "detail-page"],
      "classes": ["empty-state", "empty-state__icon", "empty-state__title", "empty-state__description", "empty-state__action", "btn--primary"],
      "requiredSlots": ["title"],
      "optionalSlots": ["icon", "description", "action"],
      "variants": ["nothingYet", "noResults", "emptySection"],
      "states": [],
      "artifactRecipe": {
        "root": "div.empty-state",
        "structure": ["optional icon", "title", "optional description", "optional action"],
        "notes": ["No-results states should offer clear filters, not create.", "Nothing-yet states may invite the page primary action."]
      }
    },
    "feed-list": {
      "intent": "Vertical list of activity or event rows.",
      "contract": "composites/feed-list.md",
      "usedByPatterns": ["detail-page"],
      "classes": ["feed-list", "feed-item", "feed-item__icon", "feed-item__main", "feed-item__time", "empty-state"],
      "requiredSlots": ["items"],
      "optionalSlots": ["rowActions", "emptyState"],
      "variants": ["info", "success", "warning", "neutral"],
      "states": ["empty"],
      "artifactRecipe": {
        "root": "ul.feed-list",
        "structure": ["li.feed-item > icon + main + time"],
        "notes": ["Use for compact event feeds; use timeline for richer chronological history."]
      }
    },
    "kv-grid": {
      "intent": "Responsive grid of key-value attributes for overview blocks.",
      "contract": "composites/kv-grid.md",
      "usedByPatterns": ["detail-page"],
      "classes": ["kv-grid", "kv-grid__row", "grid-auto-fit-kv"],
      "requiredSlots": ["items"],
      "optionalSlots": ["fullWidthRows"],
      "variants": ["autoFit", "fullRow"],
      "states": [],
      "slotSchema": {
        "items": {
          "type": "array",
          "itemShape": {
            "label": "attribute label",
            "value": "attribute value",
            "kind": "text | mono | empty"
          }
        }
      },
      "artifactRecipe": {
        "root": "div.grid-auto-fit-kv.kv-grid",
        "structure": ["key-value children"],
        "notes": ["Column count follows container width.", "Do not hand-write repeat(auto-fit, ...); use .grid-auto-fit-kv."]
      }
    },
    "list-filter": {
      "intent": "Quick search, quick filters, Search button, and visible applied filter chips.",
      "contract": "composites/list-filter.md",
      "usedByPatterns": ["list-page"],
      "classes": ["condition-band", "condition-band__toolbar", "search-input", "select", "condition-band__spacer", "applied-filters", "applied-filters__label", "filter-chip"],
      "requiredSlots": ["toolbar"],
      "optionalSlots": ["search", "quickFilters", "searchAction", "advancedAction", "appliedFilters", "clearAllAction"],
      "variants": ["simple", "advanced"],
      "states": ["draft", "applied", "emptyAppliedFilters"],
      "slotSchema": {
        "quickFilters": {
          "type": "array",
          "itemShape": {
            "label": "filter name",
            "options": "array of option labels"
          }
        },
        "appliedFilters": {
          "type": "array",
          "itemShape": {
            "label": "chip label",
            "value": "chip value"
          }
        }
      },
      "artifactRecipe": {
        "root": "div.condition-band",
        "structure": ["div.condition-band__toolbar", "optional div.applied-filters"],
        "notes": ["Search and quick filters submit on the Search button, not on change.", "Advanced is pushed right by .condition-band__spacer.", "Applied filters render no empty row when none are active."]
      }
    },
    "load-more": {
      "intent": "Append-on-click footer beneath a list or table.",
      "contract": "composites/load-more.md",
      "usedByPatterns": [],
      "classes": ["load-more", "load-more__summary", "load-more__end", "progress", "load-more__progress"],
      "requiredSlots": ["actionOrEnd"],
      "optionalSlots": ["summary", "progress"],
      "variants": ["canLoadMore", "end", "loading"],
      "states": ["loading", "exhausted"],
      "artifactRecipe": {
        "root": "div.load-more",
        "structure": ["optional summary", "button or end marker", "optional progress"],
        "notes": ["Use pagination for paged tables; use load-more for append-on-click feeds or grids."]
      }
    },
    "option-card": {
      "intent": "Large clickable radio or checkbox card.",
      "contract": "composites/option-card.md",
      "usedByPatterns": ["create-wizard", "create-form"],
      "classes": ["option-card", "radio", "option-card__icon", "option-card__body", "option-card__check"],
      "requiredSlots": ["title"],
      "optionalSlots": ["description", "icon", "selectedIndicator"],
      "variants": ["radio", "checkbox", "selected"],
      "states": ["selected", "disabled"],
      "artifactRecipe": {
        "root": "label.option-card",
        "structure": ["input.radio or checkbox", "icon", "body", "check"],
        "notes": ["Whole card is the hit target.", "Use selected state only for the chosen option."]
      }
    },
    "page-body": {
      "intent": "Guttered vertical stack for page content below the header band.",
      "contract": "composites/page-body.md",
      "usedByPatterns": ["actions", "create-form", "create-wizard", "detail-page", "list-page"],
      "classes": ["page-body", "page-header"],
      "requiredSlots": ["children"],
      "optionalSlots": ["banner", "tabs", "metricStrip", "contentSections"],
      "variants": [],
      "states": [],
      "artifactRecipe": {
        "root": "div.page-body",
        "structure": ["direct child sections in pattern-defined order"],
        "notes": ["Direct children are full-width by default.", "Do not add structural max-width wrappers inside page-body."]
      }
    },
    "page-header": {
      "intent": "Top page band that names the page and carries page-level actions.",
      "contract": "composites/page-header.md",
      "usedByPatterns": ["actions", "create-form", "create-wizard", "list-page"],
      "classes": ["page-header", "page-header__bar", "page-header__titles", "page-header__heading", "page-header__title", "page-header__count", "badge", "page-header__description", "page-header__actions"],
      "requiredSlots": ["title"],
      "optionalSlots": ["count", "status", "description", "primaryAction", "secondaryActions"],
      "variants": ["default", "sticky"],
      "states": ["loading", "wrappedActions"],
      "slotSchema": {
        "actions": {
          "type": "array",
          "itemShape": {
            "label": "button label",
            "variant": "primary | secondary | ghost | danger",
            "icon": "optional icon"
          }
        }
      },
      "artifactRecipe": {
        "root": "header.page-header",
        "structure": ["div.page-header__bar > titles + actions"],
        "notes": ["Only title is required.", "At most one primary action, rightmost.", "Use sticky for create/edit pages where Cancel and Submit must stay reachable."]
      }
    },
    "pagination": {
      "intent": "Move through pages of a collection and select row count.",
      "contract": "composites/pagination.md",
      "usedByPatterns": ["list-page"],
      "classes": ["pagination", "pagination__info", "pagination__rows", "select--sm", "pagination__summary", "pagination__pages", "pagination__page", "pagination__current", "pagination__ellipsis"],
      "requiredSlots": ["currentPage", "rangeSummary"],
      "optionalSlots": ["rowsPerPage", "prevAction", "nextAction", "numberedPages"],
      "variants": ["simple", "numbered"],
      "states": ["firstPage", "lastPage", "currentPage"],
      "artifactRecipe": {
        "root": "div.pagination",
        "structure": ["left info", "right pages"],
        "notes": ["Tables use simple prev/current/next navigation.", "Numbered pages are not for data tables unless a contract explicitly allows it."]
      }
    },
    "product-card": {
      "intent": "Catalog tile for one sellable product.",
      "contract": "composites/product-card.md",
      "usedByPatterns": [],
      "classes": ["product-grid", "product-card", "product-card__image", "product-card__placeholder", "product-card__body", "product-card__add", "btn--primary"],
      "requiredSlots": ["name"],
      "optionalSlots": ["image", "sku", "description", "price", "addAction"],
      "variants": ["image", "placeholder"],
      "states": ["available", "disabled"],
      "artifactRecipe": {
        "root": "article.product-card",
        "structure": ["image or placeholder", "body", "add action"],
        "notes": ["Use for buyer-facing product grids, not operator management tables."]
      }
    },
    "rich-pagination": {
      "intent": "Full list/table footer with rows-per-page summary and page navigation.",
      "contract": "composites/rich-pagination.md",
      "usedByPatterns": ["list-page"],
      "classes": ["rich-pagination", "rich-pagination__left", "rich-pagination__rows", "rich-pagination__summary", "pagination"],
      "requiredSlots": ["rangeSummary", "pagination"],
      "optionalSlots": ["rowsPerPage"],
      "variants": ["simple"],
      "states": ["firstPage", "lastPage"],
      "artifactRecipe": {
        "root": "div.rich-pagination",
        "structure": ["left rows/range", "pagination nav"],
        "notes": ["Use the current pagination contract for table footers; keep table navigation simple."]
      }
    },
    "skeleton": {
      "intent": "Loading placeholder blocks, rows, text, circles, and lines.",
      "contract": "composites/skeleton.md",
      "usedByPatterns": ["list-page", "detail-page", "create-form", "create-wizard"],
      "classes": ["skeleton", "skeleton-row"],
      "requiredSlots": ["shape"],
      "optionalSlots": ["rowCount", "textLines"],
      "variants": ["line", "text", "title", "block", "circle"],
      "states": ["loading"],
      "artifactRecipe": {
        "root": "span.skeleton or div.skeleton-row",
        "structure": ["one or more skeleton shapes"],
        "notes": ["Skeletons replace content in the same spatial region; do not add unrelated decoration."]
      }
    },
    "stat-card": {
      "intent": "Single key metric card for collection-level KPIs.",
      "contract": "composites/stat-card.md",
      "usedByPatterns": ["list-page", "detail-page"],
      "classes": ["stat-grid", "stat-card", "stat-card--selected", "stat-card--interactive", "stat-card__head", "stat-card__label", "stat-card__icon", "stat-card__value", "stat-card__delta", "stat-card__description"],
      "requiredSlots": ["label", "value"],
      "optionalSlots": ["icon", "delta", "description", "selected", "interactive"],
      "variants": ["static", "interactive", "selected"],
      "states": ["selected", "hover", "loading"],
      "slotSchema": {
        "metric": {
          "label": "short metric label",
          "value": "primary value",
          "delta": "optional trend label",
          "description": "optional supporting text"
        }
      },
      "artifactRecipe": {
        "root": "article.stat-card",
        "structure": ["head label/icon", "value", "optional delta", "optional description"],
        "notes": ["Use in a .stat-grid when rendering a metric strip.", "Keep labels short and scannable."]
      }
    },
    "step-indicator": {
      "intent": "Horizontal progress rail for multi-step create flows.",
      "contract": "composites/step-indicator.md",
      "usedByPatterns": ["create-wizard"],
      "classes": ["step-indicator", "step", "step--completed", "step--active", "step--upcoming", "step__dot", "step__text", "step__caption", "step__title", "step__connector"],
      "requiredSlots": ["steps", "activeStep"],
      "optionalSlots": ["completedSteps", "captions"],
      "variants": ["default"],
      "states": ["completed", "active", "upcoming"],
      "slotSchema": {
        "steps": {
          "type": "array",
          "itemShape": {
            "title": "step title",
            "caption": "optional short caption",
            "state": "completed | active | upcoming"
          }
        }
      },
      "artifactRecipe": {
        "root": "ol.step-indicator",
        "structure": ["li.step with dot, text, connector"],
        "notes": ["Use only for true multi-step flows; single forms use page-header actions."]
      }
    },
    "stepper": {
      "intent": "Numeric input with decrement and increment buttons.",
      "contract": "composites/stepper.md",
      "usedByPatterns": ["create-form", "create-wizard"],
      "classes": ["stepper", "input-group", "input-group__addon--inline-start", "input-group__addon--inline-end", "input-group--disabled"],
      "requiredSlots": ["value"],
      "optionalSlots": ["min", "max", "step", "disabled"],
      "variants": ["default", "disabled"],
      "states": ["disabled", "min", "max"],
      "artifactRecipe": {
        "root": "div.stepper.input-group",
        "structure": ["minus button", "input", "plus button"],
        "notes": ["Use for bounded numeric quantities, not free text."]
      }
    },
    "summary-bar": {
      "intent": "List result count and list-level actions directly above the table.",
      "contract": "composites/summary-bar.md",
      "usedByPatterns": ["list-page"],
      "classes": ["summary-bar", "summary-bar__count", "summary-bar__actions", "table-frame--flush"],
      "requiredSlots": ["countLabel"],
      "optionalSlots": ["actions", "selectionSummary", "sticky"],
      "variants": ["default", "sticky"],
      "states": ["idle", "selectionActive"],
      "artifactRecipe": {
        "root": "div.summary-bar",
        "structure": ["count", "actions"],
        "notes": ["Place inside .table-frame--flush above .table-scroll.", "Right actions are business-driven; do not add default Columns action.", "Selection bulk actions replace idle actions."]
      }
    },
    "theme-toggle": {
      "intent": "Icon-only light/dark theme toggle.",
      "contract": "composites/theme-toggle.md",
      "usedByPatterns": [],
      "classes": ["theme-toggle", "btn--ghost"],
      "requiredSlots": ["toggleAction"],
      "optionalSlots": ["currentTheme"],
      "variants": ["iconOnly"],
      "states": ["light", "dark"],
      "artifactRecipe": {
        "root": "button.theme-toggle.btn.btn--ghost",
        "structure": ["icon"],
        "notes": ["Dark mode is [data-theme=\"dark\"]; never edit color values."]
      }
    },
    "timeline": {
      "intent": "Vertical chronological event log for history and audit trails.",
      "contract": "composites/timeline.md",
      "usedByPatterns": ["detail-page"],
      "classes": ["timeline", "timeline__item", "timeline__marker", "timeline__content", "timeline__marker--dot", "timeline--compact", "timeline--stacked", "timeline__item--last", "timeline__header", "timeline__title", "timeline__time", "timeline__time-row", "timeline__description", "timeline__actor"],
      "requiredSlots": ["items"],
      "optionalSlots": ["actor", "description", "markerIcon", "compact"],
      "variants": ["default", "compact", "stacked", "dot", "icon"],
      "states": ["lastItem"],
      "artifactRecipe": {
        "root": "ol.timeline",
        "structure": ["li.timeline__item > marker + content"],
        "notes": ["Use for richer chronological history; use feed-list for compact event rows."]
      }
    },
    "toggles": {
      "intent": "Inline control-with-label wrappers for checkbox, radio, or switch.",
      "contract": "composites/toggles.md",
      "usedByPatterns": ["create-form", "create-wizard"],
      "classes": ["toggle-checkbox", "toggle-radio", "toggle-switch", "checkbox", "radio", "switch", "label"],
      "requiredSlots": ["control", "label"],
      "optionalSlots": ["description", "disabled"],
      "variants": ["checkbox", "radio", "switch"],
      "states": ["checked", "disabled"],
      "artifactRecipe": {
        "root": "label.toggle-checkbox | label.toggle-radio | label.toggle-switch",
        "structure": ["control", "label text"],
        "notes": ["Use switch for immediate setting changes; use checkbox/radio for form submission choices."]
      }
    },
    "list-row": {
      "intent": "Non-tabular interactive list row: a leading visual, a title with inline badges over an optional sub, and a trailing control / actions / value.",
      "contract": "composites/list-row.md",
      "usedByPatterns": [],
      "classes": ["list-rows", "list-row", "list-row__icon", "list-row__main", "list-row__title", "list-row__sub", "list-row__trailing", "list-row__value", "list-row__actions", "list-row__chevron", "badge", "avatar", "switch", "btn"],
      "requiredSlots": ["title"],
      "optionalSlots": ["icon", "avatar", "sub", "badges", "control", "value", "actions", "chevron"],
      "variants": ["interactive", "selected", "disabled"],
      "states": ["hover", "active", "focus", "selected", "disabled", "empty", "loading"],
      "artifactRecipe": {
        "root": "div.list-rows > div.list-row",
        "structure": ["leading: .list-row__icon | .avatar (optional)", ".list-row__main > .list-row__title (+ inline .badge) + .list-row__sub", "trailing: .list-row__trailing > .switch | .btn | .list-row__value + .list-row__chevron"],
        "notes": ["Hairline-separated inside a section-card / card; the last row drops the rule (do not box each row).", "Pick one primary trailing affordance per row: a switch, an action button, or a value+chevron.", "--interactive makes the whole row a click target; wrap a real button/anchor and show a chevron — cursor-pointer alone is not interactive.", "Use feed-list for events, timeline for dated sequences, kv-grid for attribute pairs, data-table for columns; list-row is the items-with-controls list none of those cover.", "Empty renders an empty-state, never a blank frame."]
      }
    }
  }
}
